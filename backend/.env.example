# RoomsWallah Backend Environment Variables Template
# Copy this file to .env and configure the secrets for production

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB)
# In production, replace with your hosted MongoDB connection string (e.g. MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/roomswallah

# JSON Web Token Secret
# Change this to a long random secure string in production
JWT_SECRET=your_jwt_signing_secret_key_minimum_32_characters

# CORS Settings (Target frontend URL)
CORS_ORIGIN=http://localhost:3000

# Admin Chief Credentials
# Required to login to the admin dashboard
ADMIN_EMAIL=admin@roomswallah.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Google OAuth Configuration (Optional, for OAuth login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
